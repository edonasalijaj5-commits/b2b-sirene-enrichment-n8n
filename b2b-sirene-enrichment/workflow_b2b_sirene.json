              "value": "={{ $json.adresse_siege }}",
              "type": "string"
            },
            {
              "id": "crm5",
              "name": "contact_principal",
              "value": "={{ $json.email_contact }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5",
      "name": "Formatage Fiche CRM",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
